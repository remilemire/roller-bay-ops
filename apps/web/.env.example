# Local development calls the API directly.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# IANA time zone used for operational timestamps and production corrections.
FACILITY_TIME_ZONE=America/Edmonton

# Vercel: set API_ORIGIN to the public Render HTTPS origin (no /api suffix).
# Leave NEXT_PUBLIC_API_URL unset on Vercel so browsers use /api on the frontend.
# API_ORIGIN=https://your-api.onrender.com
# Vercel: the same value as the API's API_PROXY_SECRET. Server-only; never NEXT_PUBLIC_.
# API_PROXY_SECRET=
