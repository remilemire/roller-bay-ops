DATABASE_URL=postgresql://roller_bay:roller_bay_local@localhost:5434/roller_bay_ops
PORT=3001
HOST=127.0.0.1
REDIS_URL=redis://localhost:6380
WEB_ORIGIN=http://localhost:3000

# Per-IP budgets; login and callback share the stricter login budget.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_API_LIMIT=600
RATE_LIMIT_LOGIN_LIMIT=30

# Required: your single-tenant Microsoft Entra app registration.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3001/api/auth/callback
AUTH_ALLOWED_DOMAIN=
# Optional after setup; this Microsoft profile email becomes owner if none exists.
BOOTSTRAP_OWNER_EMAIL=
# Generate a 32-character random secret: openssl rand -base64 24
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=604800
# Optional comma-separated IPs/CIDRs of trusted reverse proxies.
TRUSTED_PROXY_IPS=

# Optional: same private solver key as apps/solver/.env. Without it, manual allocation endpoints still work.
SOLVER_URL=http://127.0.0.1:8001
SOLVER_API_KEY=

# Cutting rules in millimetres, snapshotted when a plan is created.
# 1 inch per outside edge; reusable pieces must be at least 60 x 60 inches.
CUTTING_EDGE_TRIM_MM=25.4
CUTTING_MINIMUM_REMNANT_WIDTH_MM=1524
CUTTING_MINIMUM_REMNANT_LENGTH_MM=1524
# Added once to each blind's finished drop (10 inches).
CUTTING_DROP_ALLOWANCE_MM=254
