{
  "name": "roller-bay-ops",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo watch dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "npm run test:integration --workspace=@roller-bay/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose stop",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "redis:up": "docker compose up -d --wait session-redis",
    "redis:down": "docker compose stop session-redis",
    "db:generate": "npm run db:generate --workspace=@roller-bay/api --",
    "db:migrate": "npm run db:migrate --workspace=@roller-bay/api --",
    "db:studio": "npm run db:studio --workspace=@roller-bay/api --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.6.2",
    "turbo": "^2.10.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "^2.3.0"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
